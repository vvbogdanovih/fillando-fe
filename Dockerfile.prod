# Stage 1: Build
FROM node:24-alpine AS builder
WORKDIR /app

# Оголошуємо аргументи збірки.
# NEXT_PUBLIC_* інлайняться під час `yarn build`, тому вони мають бути саме
# build-аргументами. Додати їх у .env.prod недостатньо — той env_file бачить
# лише runtime-контейнер (stage 2), а не цю стадію.
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_USE_IMAGE_DERIVATIVES=false
ARG NEXT_PUBLIC_GOOGLE_ADS_ID
ARG NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_CONVERSION
ARG NEXT_PUBLIC_GOOGLE_ANALYTICS_ID
ARG NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION

# Перетворюємо аргументи в змінні оточення для процесу build
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_USE_IMAGE_DERIVATIVES=$NEXT_PUBLIC_USE_IMAGE_DERIVATIVES
ENV NEXT_PUBLIC_GOOGLE_ADS_ID=$NEXT_PUBLIC_GOOGLE_ADS_ID
ENV NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_CONVERSION=$NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_CONVERSION
ENV NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=$NEXT_PUBLIC_GOOGLE_ANALYTICS_ID
ENV NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=$NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile
COPY . .
RUN yarn build

# Stage 2: Runner
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV production

# Копіюємо тільки необхідні файли для standalone режиму
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000

# server.js створюється автоматично при output: 'standalone'
CMD ["node", "server.js"]